  "info": {
    "title": "Vitrine API",
    "description": "API do marketplace de moda Vitrine. Rotas privadas pedem o token de sessão do Clerk (Authorization: Bearer). Erros seguem a RFC 9457 (application/problem+json).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "clerk": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Token de sessão do Clerk"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "code": {
            "description": "Código do erro de domínio, ex.: SLUG_TAKEN.",
            "type": "string"
          },
          "errors": {
            "description": "Campos inválidos, quando code = VALIDATION_FAILED.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "additionalProperties": false
      },
      "SizeChart": {
        "type": "object",
        "properties": {
          "columns": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "rows": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        },
        "required": [
          "columns",
          "rows"
        ],
        "additionalProperties": false,
        "description": "Guia de medidas: cada linha tem o mesmo número de colunas."
      },
      "CreateCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sizeType": {
            "type": "string",
            "enum": [
              "CLOTHING",
              "SHOES",
              "ONE_SIZE"
            ],
            "description": "Grade de tamanhos: CLOTHING (PP–XGG), SHOES (33–46) ou ONE_SIZE (U)."
          },
          "slug": {
            "description": "Gerado do nome quando omitido.",
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "parentId": {
            "description": "Categoria pai; omitido ou null = primeiro nível.",
            "nullable": true,
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "position": {
            "description": "Ordem entre as irmãs (padrão 0).",
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "sizeChart": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SizeChart"
              }
            ]
          }
        },
        "required": [
          "name",
          "sizeType"
        ],
        "additionalProperties": false
      },
      "UpdateCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sizeType": {
            "type": "string",
            "enum": [
              "CLOTHING",
              "SHOES",
              "ONE_SIZE"
            ],
            "description": "Grade de tamanhos: CLOTHING (PP–XGG), SHOES (33–46) ou ONE_SIZE (U)."
          },
          "slug": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "parentId": {
            "nullable": true,
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "sizeChart": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SizeChart"
              }
            ]
          }
        },
        "additionalProperties": false,
        "description": "Só os campos enviados mudam."
      },
      "PublicCategoryNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sizeType": {
            "type": "string",
            "enum": [
              "CLOTHING",
              "SHOES",
              "ONE_SIZE"
            ],
            "description": "Grade de tamanhos: CLOTHING (PP–XGG), SHOES (33–46) ou ONE_SIZE (U)."
          },
          "sizeChart": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SizeChart"
              }
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicCategoryNode"
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "sizeType",
          "sizeChart",
          "children"
        ],
        "additionalProperties": false
      },
      "AdminCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "parentId": {
            "nullable": true,
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sizeType": {
            "type": "string",
            "enum": [
              "CLOTHING",
              "SHOES",
              "ONE_SIZE"
            ],
            "description": "Grade de tamanhos: CLOTHING (PP–XGG), SHOES (33–46) ou ONE_SIZE (U)."
          },
          "sizeChart": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SizeChart"
              }
            ]
          },
          "archivedAt": {
            "nullable": true,
            "description": "Preenchido quando a categoria está arquivada.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "parentId",
          "name",
          "slug",
          "position",
          "sizeType",
          "sizeChart",
          "archivedAt"
        ],
        "additionalProperties": false
      },
      "AdminCategoryNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "parentId": {
            "nullable": true,
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sizeType": {
            "type": "string",
            "enum": [
              "CLOTHING",
              "SHOES",
              "ONE_SIZE"
            ],
            "description": "Grade de tamanhos: CLOTHING (PP–XGG), SHOES (33–46) ou ONE_SIZE (U)."
          },
          "sizeChart": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/SizeChart"
              }
            ]
          },
          "archivedAt": {
            "nullable": true,
            "description": "Preenchido quando a categoria está arquivada.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminCategoryNode"
            }
          }
        },
        "required": [
          "id",
          "parentId",
          "name",
          "slug",
          "position",
          "sizeType",
          "sizeChart",
          "archivedAt",
          "children"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Papéis guardados na Vitrine: customer, seller, admin."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  }
}
