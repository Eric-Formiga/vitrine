{
  "name": "vitrine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  },
  "prettier": "@vitrine/config/prettier",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitrine/config": "workspace:*",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
