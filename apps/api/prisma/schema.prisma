// Schema do banco da Vitrine (Postgres). Os modelos entram tarefa a tarefa,
// seguindo docs/DATA_MODEL.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // SKU único só entre as variantes ativas da loja (ASM-024): índice único parcial.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Pessoas da plataforma, espelhadas do Clerk. É a fonte de verdade dos papéis.
// Nunca é apagada: conta excluída é anonimizada (spec 01, casos de borda).
model User {
  id        String    @id @default(uuid(7)) @db.Uuid
  clerkId   String    @unique @map("clerk_id")
  email     String    @unique
  name      String?
  phone     String?
  roles     String[]  @default(["customer"])
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]
  seller    Seller?

  @@map("users")
}

// Grade de tamanhos das variantes dos produtos da categoria (spec 03).
enum SizeType {
  CLOTHING // PP a XGG
  SHOES // 33 a 46
  ONE_SIZE // U

  @@map("size_type")
}

// Árvore do catálogo (RF-CAT-4). Nunca é apagada: arquivar marca a categoria e as
// descendentes com archived_at, e o slug continua reservado.
model Category {
  id         String    @id @default(uuid(7)) @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  name       String
  slug       String    @unique
  position   Int       @default(0)
  sizeType   SizeType  @map("size_type")
  sizeChart  Json?     @map("size_chart")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  sellers  Seller[]
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("seller_status")
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  EVP

  @@map("pix_key_type")
}

// Lojas (spec 02). Uma por conta e uma por CPF/CNPJ. O documento nunca fica em texto
// puro: vai cifrado (AES-256-GCM) e, para a unicidade, como hash com chave (ASM-016).
// A chave Pix só é gravada depois de o titular ser conferido no Asaas (ADR-0012).
model Seller {
  id                  String       @id @default(uuid(7)) @db.Uuid
  userId              String       @unique @map("user_id") @db.Uuid
  storeName           String       @map("store_name")
  slug                String       @unique
  bio                 String
  instagram           String?
  mainCategoryId      String       @map("main_category_id") @db.Uuid
  documentEncrypted   String       @map("document_encrypted")
  documentHash        String       @unique @map("document_hash")
  status              SellerStatus @default(PENDING)
  pixKeyType          PixKeyType   @map("pix_key_type")
  pixKey              String       @map("pix_key")
  pixKeyOwnerName     String       @map("pix_key_owner_name")
  pixKeyOwnerDocument String       @map("pix_key_owner_document")
  pixKeyVerifiedAt    DateTime     @map("pix_key_verified_at")
  // Nulo = comissão padrão da plataforma (RN-3).
  commissionBps       Int?         @map("commission_bps")
  appliedAt           DateTime     @default(now()) @map("applied_at")
  approvedAt          DateTime?    @map("approved_at")
  rejectedAt          DateTime?    @map("rejected_at")
  rejectionReason     String?      @map("rejection_reason")
  suspendedAt         DateTime?    @map("suspended_at")
  suspensionReason    String?      @map("suspension_reason")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  mainCategory Category          @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict)
  shipping     ShippingSettings?
  products     Product[]
  variants     ProductVariant[]
  uploads      Upload[]

  @@index([status, appliedAt])
  @@map("sellers")
}

// Frete da loja (spec 02): uma configuração por loja. O cálculo no carrinho é da Fase 2.
// Os limites (CEP, valores ≥ 0, prazo de 1 a 5 dias) também são CHECK no banco.
model ShippingSettings {
  sellerId                   String   @id @map("seller_id") @db.Uuid
  originZip                  String   @map("origin_zip") @db.Char(8)
  /// Centavos por região: { "N": 2990, "NE": 2490, "CO": 2290, "SE": 1590, "S": 1990 }
  rates                      Json
  freeShippingThresholdCents Int?     @map("free_shipping_threshold_cents")
  handlingDays               Int      @map("handling_days")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("shipping_settings")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUSPENDED

  @@map("product_status")
}

enum ProductCondition {
  NEW
  USED

  @@map("product_condition")
}

// Produtos das lojas (spec 03). Nunca são apagados: arquivar muda a situação (RN-17).
// `version` sobe a cada escrita e vira o ETag; o If-Match evita que uma aba sobrescreva
// a outra (ASM-026). `min_price_cents` acompanha a variante ativa mais barata.
model Product {
  id               String           @id @default(uuid(7)) @db.Uuid
  sellerId         String           @map("seller_id") @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  title            String
  slug             String
  description      String           @default("")
  condition        ProductCondition
  status           ProductStatus    @default(DRAFT)
  version          Int              @default(1)
  minPriceCents    Int?             @map("min_price_cents")
  publishedAt      DateTime?        @map("published_at")
  suspendedAt      DateTime?        @map("suspended_at")
  suspensionReason String?          @map("suspension_reason")
  archivedAt       DateTime?        @map("archived_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  seller   Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@unique([sellerId, slug])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([status, categoryId, minPriceCents])
  @@map("products")
}

// Uma combinação de tamanho × cor. Sair da grade arquiva a variante (os pedidos da
// Fase 2 apontam para ela); voltar reativa a mesma linha. `seller_id` é cópia do
// produto, para o SKU ser único por loja. Os limites também são CHECK no banco.
model ProductVariant {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  sellerId       String    @map("seller_id") @db.Uuid
  sku            String
  size           String
  color          String
  colorHex       String    @map("color_hex") @db.Char(7)
  priceCents     Int       @map("price_cents")
  compareAtCents Int?      @map("compare_at_cents")
  stock          Int       @default(0)
  // Reservado por checkouts em andamento (Fase 2); por ora, sempre 0.
  reserved       Int       @default(0)
  weightGrams    Int       @map("weight_grams")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([productId, size, color])
  @@unique([sellerId, sku], map: "product_variants_seller_id_sku_active_key", where: raw("archived_at IS NULL"))
  @@map("product_variants")
}

// Fotos do produto, na ordem (a de posição 0 é a capa). `color` nulo = vale para todas
// as cores. O arquivo é um upload registrado: a chave estrangeira impede a limpeza de
// apagar um arquivo em uso.
model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  path      String
  alt       String   @default("")
  position  Int
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  upload  Upload  @relation(fields: [path], references: [path], onDelete: Restrict)

  @@unique([productId, position])
  @@index([path])
  @@map("product_images")
}

// Arquivos enviados ao Storage pela URL assinada (spec 03 H2). Nunca usado há mais de
// 24 h, ou desligado de um produto (`detached_at`) há mais de 24 h: a limpeza apaga.
model Upload {
  path        String    @id
  sellerId    String    @map("seller_id") @db.Uuid
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  createdAt   DateTime  @default(now()) @map("created_at")
  detachedAt  DateTime? @map("detached_at")

  seller Seller         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  images ProductImage[]

  @@index([createdAt])
  @@index([detachedAt])
  @@map("uploads")
}

// Quem fez o quê na área de admin, com o estado antes e depois (RF-ADM-5, spec 10).
// Só cresce: nada aqui é editado ou apagado pela aplicação.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Avisos (webhooks) recebidos do Asaas, um por id de evento: o Asaas reenvia o mesmo
// aviso, e a chave primária garante que cada um é processado uma vez (spec 05).
// processed_at nulo = gravado, mas o processamento não terminou (será refeito no reenvio).
model AsaasEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@map("asaas_events")
}
