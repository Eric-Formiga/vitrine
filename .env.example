# Copie para .env e ajuste. Nunca commite o .env.
# A API valida estas variáveis ao subir e recusa iniciar se faltar alguma obrigatória.

# API (apps/api)
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
DATABASE_URL=postgresql://vitrine:vitrine@localhost:5432/vitrine
# true: a API também processa as filas (demo); false: só enfileira (ADR-0010)
RUN_WORKER=true
# Segredo do endpoint de webhook criado no painel do Clerk (começa com whsec_).
# O valor abaixo é só um marcador, não é um segredo: troque pelo do seu endpoint.
CLERK_WEBHOOK_SECRET=whsec_dHJvcXVlLXBlbG8tc2VncmVkby1kby1jbGVyaw==
# Chave pública (PEM) da instância: painel do Clerk → API keys → "JWT public key".
# Pode ficar numa linha só, trocando as quebras de linha por \n.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\ntroque-pela-chave-publica-do-clerk\n-----END PUBLIC KEY-----"
# Chave secreta da API do Clerk (sk_...): usada só para cadastrar no primeiro acesso.
CLERK_SECRET_KEY=sk_troque-pela-chave-secreta-do-clerk
# Origens do site que podem usar os tokens (claim azp), separadas por vírgula.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Asaas (pagamentos, ADR-0011). Chave do sandbox: painel do Asaas sandbox → Integrações.
# Entre aspas simples: a chave começa com $ e não pode ser expandida.
ASAAS_API_KEY='$aact_troque-pela-chave-do-sandbox'
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas manda no cabeçalho asaas-access-token dos webhooks (32 a 255 caracteres).
# Gere um aleatório, ex.: node -e "console.log(crypto.randomBytes(36).toString('base64url'))"
ASAAS_WEBHOOK_TOKEN=troque-por-um-token-aleatorio-com-32-ou-mais-caracteres

# Site (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3333
