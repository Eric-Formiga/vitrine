# Copie para .env e ajuste. Nunca commite o .env.
# A API valida estas variáveis ao subir e recusa iniciar se faltar alguma obrigatória.

# API (apps/api)
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
DATABASE_URL=postgresql://vitrine:vitrine@localhost:5432/vitrine
# true: a API também processa as filas (demo); false: só enfileira (ADR-0010)
RUN_WORKER=true
# Segredo do endpoint de webhook criado no painel do Clerk (começa com whsec_).
# O valor abaixo é só um marcador, não é um segredo: troque pelo do seu endpoint.
CLERK_WEBHOOK_SECRET=whsec_dHJvcXVlLXBlbG8tc2VncmVkby1kby1jbGVyaw==

# Site (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3333
